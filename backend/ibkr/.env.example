# IBKR TWS Socket API
# TWS must be running with API connections enabled.
# Enable via TWS: Edit → Global Configuration → API → Settings
#   - Enable ActiveX and Socket Clients: checked
#   - Socket port: 7496 (live) or 7497 (paper trading)
#   - Trusted IP addresses: 127.0.0.1
TWS_HOST=127.0.0.1
TWS_PORT=7496
TWS_CLIENT_ID=1

# Scanner settings
SCAN_BATCH_SIZE=5
OPTIONS_CACHE_TTL=300
QUOTE_CACHE_TTL=5
